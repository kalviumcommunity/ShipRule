# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Node Modules
node_modules/

# Local Data Files (Ignore contents, allow .gitkeep placeholder)
data/*
!data/.gitkeep

# Generated Output Files (Ignore contents, allow .gitkeep placeholder)
outputs/*
!outputs/.gitkeep

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & IDE Metadata
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
