# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Node Modules
node_modules/

# Local Data Files (Ignore contents, allow .gitkeep placeholder)
data/*
!data/.gitkeep

# Vector DB & Storage
chroma_db/
.chroma/
*.sqlite3
*.db

# Generated Output Files (Ignore contents, allow .gitkeep placeholder and sample outputs)
outputs/*
!outputs/.gitkeep
!outputs/sample_output.txt
!outputs/prompt_comparison_output.txt
!outputs/token_analysis_output.txt
!outputs/prompt_template_renders.txt

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing, Logs & Temporary Files
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.log
*.tmp
*.temp
*.bak

# IDE & OS Metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

